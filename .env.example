# Environment-variable reference only. The application does not read ./.env.
# Never commit real credentials.

# Optional: the app uses GITHUB_TOKEN/GH_TOKEN first, then `gh auth token`.
# GITHUB_TOKEN=github_pat_replace_me

CACHE_BACKEND=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=github_member_stats

# First-run seed only: choose an organization OR an explicit repository array.
# After application_config/default is created, MongoDB supplies this scope.
GITHUB_ORGANIZATION=your-company
GITHUB_REPOSITORIES_JSON=[]
# GITHUB_REPOSITORIES_JSON=["your-company/api","your-company/payments"]

# Current-month results older than this are refreshed on demand.
CACHE_TTL_SECONDS=3600

# Maximum detail records per category returned to Copilot. Totals remain exact.
ACTIVITY_DETAIL_LIMIT=200
TEAM_MEMBER_CONCURRENCY=4

# Append-only conversation diagnostics stored in MongoDB. MongoDB automatically
# expires records after the configured number of days. Tokens are always redacted.
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=30
AUDIT_INCLUDE_USER_MESSAGES=true
AUDIT_INCLUDE_ASSISTANT_RESPONSES=true

# Optional Copilot settings. When blank, the app reuses GITHUB_TOKEN/GH_TOKEN.
# That token must be user-owned and have Account > Copilot Requests permission.
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
